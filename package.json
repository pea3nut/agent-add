{
  "name": "agent-add",
  "version": "1.3.0",
  "description": "Cross-host AI Agent Pack installer — install MCP, Skill, Prompt, Command, Sub-agent in one command",
  "repository": {
    "type": "git",
    "url": "https://github.com/pea3nut/agent-add.git"
  },
  "bugs": {
    "url": "https://github.com/pea3nut/agent-add/issues"
  },
  "homepage": "https://github.com/pea3nut/agent-add",
  "bin": {
    "agent-add": "bin/agent-add.js"
  },
  "files": [
    "bin",
    "docs",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run tests/unit tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:runtime": "node tests/runtime/cli.test.cjs",
    "test:integration": "vitest run tests/integration",
    "lint": "tsc --noEmit",
    "agent-add": "tsx src/index.ts",
    "install:vibe": "npm run agent-add -- --pack vibe/manifest.json"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai",
    "agent",
    "mcp",
    "cursor",
    "claude"
  ],
  "license": "MPL-2.0",
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@decimalturn/toml-patch": "3.3.2",
    "@inquirer/select": "4.3.4",
    "@types/node": "^25.5.0",
    "@types/unicode-properties": "^1.3.2",
    "commander": "13.1.0",
    "fast-json-patch": "3.1.1",
    "gray-matter": "4.0.3",
    "jsonc-parser": "3.3.1",
    "marked": "^15.0.12",
    "smol-toml": "^1.9.1",
    "toml-patch-lite": "npm:@decimalturn/toml-patch@3.3.2-lite",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unicode-properties": "^1.4.1",
    "vitest": "^4.1.0",
    "yaml": "^2.8.3",
    "zod": "^4.6.6"
  }
}
